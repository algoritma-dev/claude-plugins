#!/bin/sh
# Test double for the glab CLI.
#
# Records every call and answers from fixture files:
#   $STUB_GLAB_CALLS       one line per call, the full argument list
#   $STUB_GLAB_STDIN       the request body, when the call reads one (--input -)
#   $STUB_GLAB_REPLY       stdout for a generic call
#   $STUB_GLAB_REPLY_USER  stdout for `api user`, when set
#   $STUB_GLAB_REPLY_MR    stdout for reading one merge request, when set
#   $STUB_GLAB_FAIL_MATCH  a call whose arguments contain this substring exits 22;
#                          the arguments are matched with a trailing space, so
#                          "merge_requests/7 " names that endpoint alone
#
# The stub rejects flags the real glab does not have. glab api offers
# --field/--header/--hostname/--include/--input/--method/--output/--paginate/
# --raw-field/--silent and nothing else; accepting anything else here would let
# a script that calls a nonexistent flag pass its tests and fail in CI.
set -e

if [ -n "${STUB_GLAB_CALLS:-}" ]; then
    echo "$*" >> "$STUB_GLAB_CALLS"
fi

for arg in "$@"; do
    case "$arg" in
        --field|--header|--hostname|--include|--input|--method|--output|--paginate|--raw-field|--silent|--form|--message)
            ;;
        --*)
            echo "stub-glab: Unknown flag: $arg." >&2
            exit 1
            ;;
    esac
done

case "$*" in
    *--input\ -*)
        if [ -n "${STUB_GLAB_STDIN:-}" ]; then
            cat > "$STUB_GLAB_STDIN"
        else
            cat > /dev/null
        fi
        ;;
esac

if [ -n "${STUB_GLAB_FAIL_MATCH:-}" ]; then
    case "$* " in
        *"$STUB_GLAB_FAIL_MATCH"*)
            echo "stub-glab: simulated failure for '$STUB_GLAB_FAIL_MATCH'" >&2
            exit 22
            ;;
    esac
fi

case "$*" in
    *"api user"*)
        if [ -n "${STUB_GLAB_REPLY_USER:-}" ] && [ -r "$STUB_GLAB_REPLY_USER" ]; then
            cat "$STUB_GLAB_REPLY_USER"
            exit 0
        fi
        ;;
esac

if [ -n "${STUB_GLAB_REPLY_MR:-}" ] && [ -r "$STUB_GLAB_REPLY_MR" ] \
    && printf '%s' "$*" | grep -Eq 'merge_requests/[0-9]+$'; then
    cat "$STUB_GLAB_REPLY_MR"
    exit 0
fi

if [ -n "${STUB_GLAB_REPLY:-}" ] && [ -r "$STUB_GLAB_REPLY" ]; then
    cat "$STUB_GLAB_REPLY"
fi
